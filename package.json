{
  "name": "dsh-sidebar-entry-manager",
  "version": "0.2.2",
  "description": "Manage which plugin entries appear in the DeepSeek Harness left sidebar: hide or show any sidebar panel row without disabling the plugin.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "sidebar",
    "sidebar-entry-manager",
    "ui"
  ],
  "author": {
    "name": "weiaisuyan",
    "url": "https://github.com/weiaisuyan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weiaisuyan/dsh-sidebar-entry-manager.git"
  },
  "homepage": "https://github.com/weiaisuyan/dsh-sidebar-entry-manager#readme",
  "bugs": {
    "url": "https://github.com/weiaisuyan/dsh-sidebar-entry-manager/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "node --check src/host.js && node --check src/client.js && node --check scripts/build.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
